# GridWise Energy Optimizer - Environment Configuration
# Copy this file to .env and configure your desired parameters.

# Service Binding
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration
# Options: deepseek, groq, openai, gemini, openrouter, local, fallback
LLM_PROVIDER=deepseek

# Primary Model API Key (Do not commit real keys)
# You can set LLM_API_KEY directly, or set DEEPSEEK_API_KEY / GROQ_API_KEY / OPENAI_API_KEY
LLM_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Model Identifier
# Recommended for DeepSeek: deepseek-flash (verified 10/10 on the public samples)
# Recommended for Groq: llama-3.3-70b-versatile or llama-3.1-8b-instant
# Recommended for OpenAI: gpt-4o-mini
# Recommended for Gemini: gemini-1.5-flash
LLM_MODEL=deepseek-flash

# Endpoint Base URL (Optional: defaults to standard provider endpoint)
# DeepSeek: https://api.deepseek.com
# Groq: https://api.groq.com/openai/v1
# OpenAI: https://api.openai.com/v1
# Local / vLLM / Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com

# Request Timeout in Seconds (Judge requirement: < 30 seconds)
REQUEST_TIMEOUT=20.0
